<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Screen title. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Pantry Item"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Allows the user to edit the pantry item's name. -->
        <EditText
            android:id="@+id/editItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Item name"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <!-- Allows the user to edit the quantity available. -->
        <EditText
            android:id="@+id/editItemQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantity"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <!-- Allows the user to edit the unit of measurement. -->
        <EditText
            android:id="@+id/editItemUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unit (e.g. kg, L, items)"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <!-- Allows the user to edit the expiry date. -->
        <EditText
            android:id="@+id/editItemExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Expiry date (optional)"
            android:inputType="text"
            android:layout_marginBottom="24dp" />

        <!-- Saves the changes made to the pantry item. -->
        <Button
            android:id="@+id/buttonUpdateItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Item" />

    </LinearLayout>

</ScrollView>