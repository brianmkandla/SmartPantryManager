<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Screen heading. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Pantry Item"
            android:textColor="@color/pantry_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Supporting text. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Add an ingredient you currently have in your pantry."
            android:textColor="@color/pantry_text_secondary"
            android:textSize="15sp" />

        <!-- Item name. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Item name"
            android:textColor="@color/pantry_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editItemName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/pantry_input_background"
            android:hint="e.g. Chicken"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/pantry_text"
            android:textColorHint="@color/pantry_text_secondary"
            android:textSize="16sp" />

        <!-- Quantity. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Quantity"
            android:textColor="@color/pantry_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editItemQuantity"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/pantry_input_background"
            android:hint="e.g. 2"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/pantry_text"
            android:textColorHint="@color/pantry_text_secondary"
            android:textSize="16sp" />

        <!-- Unit. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Unit"
            android:textColor="@color/pantry_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editItemUnit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/pantry_input_background"
            android:hint="e.g. kg, cups, items"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/pantry_text"
            android:textColorHint="@color/pantry_text_secondary"
            android:textSize="16sp" />

        <!-- Expiry date. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Expiry date"
            android:textColor="@color/pantry_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editItemExpiry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/pantry_input_background"
            android:hint="Optional"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/pantry_text"
            android:textColorHint="@color/pantry_text_secondary"
            android:textSize="16sp" />

        <!-- Save action. -->
        <Button
            android:id="@+id/buttonSaveItem"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/pantry_green"
            android:text="Save Item"
            android:textAllCaps="false"
            android:textColor="@color/pantry_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>