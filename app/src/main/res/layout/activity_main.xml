<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App heading. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Smart Pantry"
                    android:textColor="@color/pantry_text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Make the most of what you have."
                    android:textColor="@color/pantry_text_secondary"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- Settings icon. -->
            <ImageButton
                android:id="@+id/buttonSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Settings"
                android:padding="12dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/pantry_text" />

        </LinearLayout>

        <!-- Pantry overview. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/settings_card_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Pantry"
                android:textColor="@color/pantry_green_dark"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPantrySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="0 items currently in your pantry."
                android:textColor="@color/pantry_text_secondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/buttonViewPantry"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/pantry_green"
                android:text="View My Pantry"
                android:textAllCaps="false"
                android:textColor="@color/pantry_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Recipe discovery section. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Recipes"
            android:textColor="@color/pantry_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Find something you can make with your current ingredients."
            android:textColor="@color/pantry_text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonSuggestedRecipes"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/pantry_green_light"
            android:text="Find Recipes"
            android:textAllCaps="false"
            android:textColor="@color/pantry_green_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Most frequently cooked recipes. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/settings_card_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Most Used Recipes"
                android:textColor="@color/pantry_green_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Your go-to recipes will appear here."
                android:textColor="@color/pantry_text_secondary"
                android:textSize="14sp" />

            <!-- Recipe rows are added here by MainActivity. -->
            <LinearLayout
                android:id="@+id/mostCookedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <!-- Empty state shown before any recipe has been cooked. -->
            <TextView
                android:id="@+id/textNoMostCooked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/pantry_empty_background"
                android:gravity="center"
                android:padding="18dp"
                android:text="Cook a recipe and it will appear here."
                android:textColor="@color/pantry_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Future feature. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/settings_card_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Video Instructions"
                android:textColor="@color/pantry_green_dark"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Step-by-step cooking videos are coming soon."
                android:textColor="@color/pantry_text_secondary"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>