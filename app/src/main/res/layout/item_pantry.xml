<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/pantry_card_background"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Ingredient name. -->
    <TextView
        android:id="@+id/textItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/pantry_text"
        android:textSize="19sp"
        android:textStyle="bold" />

    <!-- Quantity and unit. -->
    <TextView
        android:id="@+id/textItemQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/pantry_green_dark"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Expiry information. -->
    <TextView
        android:id="@+id/textItemExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/pantry_text_secondary"
        android:textSize="14sp" />

    <!-- Card actions. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <!-- Edit action. -->
        <Button
            android:id="@+id/buttonEditItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/pantry_green_light"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="@color/pantry_green_dark"
            android:textSize="14sp" />

        <!-- Delete action. -->
        <Button
            android:id="@+id/buttonDeleteItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/pantry_danger"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="@color/pantry_surface"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>