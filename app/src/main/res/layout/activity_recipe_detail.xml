<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Recipe header. -->
        <TextView
            android:id="@+id/textRecipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pantry_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textRecipeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/pantry_text_secondary"
            android:textSize="16sp"
            android:lineSpacingExtra="2dp" />

        <!-- Ingredients section. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Ingredients"
            android:textColor="@color/pantry_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/recipe_detail_card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/textRecipeIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/pantry_text"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <!-- Instructions section. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Instructions"
            android:textColor="@color/pantry_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/recipe_detail_card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/textRecipeInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/pantry_text"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <!-- Back button. -->
        <Button
            android:id="@+id/buttonBack"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/pantry_green"
            android:text="Back to Recipes"
            android:textAllCaps="false"
            android:textColor="@color/pantry_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>