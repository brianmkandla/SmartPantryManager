<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/recipe_card_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Recipe name. -->
    <TextView
        android:id="@+id/textRecipeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/pantry_text"
        android:textSize="19sp"
        android:textStyle="bold" />

    <!-- Recipe description. -->
    <TextView
        android:id="@+id/textRecipeDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="@color/pantry_text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="2dp" />

    <!-- Indicates that the recipe can be opened. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="View recipe  →"
        android:textColor="@color/pantry_green"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>